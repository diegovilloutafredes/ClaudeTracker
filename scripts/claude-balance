#!/usr/bin/env bash
# claude-balance — auto-select the best Claude Code account before `claude` runs.
#
# Reads ClaudeTracker's exported state file
# (~/Library/Application Support/ClaudeTracker/balance.json), applies the user's
# strategy (Manual / Prioritize / Balance), and copies the chosen account's
# saved Keychain entry onto the active "Claude Code-credentials" slot if a
# switch is warranted.
#
# Designed to be called from a shell wrapper around `claude`:
#
#   # in ~/.zshrc or ~/.bashrc:
#   claude() { claude-balance >/dev/null 2>&1; command claude "$@"; }
#
# Safety: every error path exits 0 silently so it never blocks `claude`. If
# anything is missing (file, entries, scores), the active credential is left
# untouched.

set -uo pipefail

STATE_FILE="$HOME/Library/Application Support/ClaudeTracker/balance.json"
ACTIVE_SVC="Claude Code-credentials"
SAVED_PREFIX="Claude Code-account-"
STALE_SECONDS=300  # 5 minutes — older state is ignored
ACCT="$USER"

# ── helpers ──────────────────────────────────────────────────────────────
log()  { :; }   # silent by default; uncomment next line to debug:
                # log() { echo "[claude-balance] $*" >&2; }
quit() { log "$1"; exit 0; }

[[ -r "$STATE_FILE" ]] || quit "no state file"
command -v jq >/dev/null 2>&1 || quit "jq not installed"
command -v security >/dev/null 2>&1 || quit "security CLI missing"

# ── freshness gate ───────────────────────────────────────────────────────
exported=$(jq -r '.exportedAt // empty' "$STATE_FILE") || quit "bad json"
[[ -n "$exported" ]] || quit "no exportedAt"
exported_ts=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "${exported%.*Z}Z" "+%s" 2>/dev/null) \
  || exported_ts=$(date -j -f "%Y-%m-%dT%H:%M:%S%z" "$exported" "+%s" 2>/dev/null) \
  || quit "unparseable exportedAt"
now_ts=$(date +%s)
age=$(( now_ts - exported_ts ))
[[ $age -lt $STALE_SECONDS ]] || quit "state stale ($age s)"

# ── strategy + override window ───────────────────────────────────────────
strategy_kind=$(jq -r '.strategy | (keys[0] // "manual")' "$STATE_FILE")
[[ "$strategy_kind" != "manual" ]] || quit "strategy=manual"

trigger_on=$(jq -r '.triggerOnClaude // false' "$STATE_FILE")
[[ "$trigger_on" == "true" ]] || quit "shell hook disabled in settings"

last_manual=$(jq -r '.lastManualSwitch // empty' "$STATE_FILE")
if [[ -n "$last_manual" ]]; then
    last_ts=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "${last_manual%.*Z}Z" "+%s" 2>/dev/null) \
      || last_ts=$(date -j -f "%Y-%m-%dT%H:%M:%S%z" "$last_manual" "+%s" 2>/dev/null) \
      || last_ts=0
    if (( now_ts - last_ts < 300 )); then
        quit "manual override window active"
    fi
fi

current_id=$(jq -r '.currentAccountID // empty' "$STATE_FILE")

# ── pick target id ───────────────────────────────────────────────────────
case "$strategy_kind" in
  prioritize)
    preferred=$(jq -r '.strategy.prioritize.preferredID // empty' "$STATE_FILE")
    threshold=$(jq -r '.strategy.prioritize.threshold // 80' "$STATE_FILE")
    [[ -n "$preferred" ]] || quit "prioritize: no preferredID"
    # Compute preferred's worst-window utilization (100 - slack).
    pref_util=$(jq -r --arg id "$preferred" '
        .accounts[] | select(.id==$id and .linked==true)
        | (100 - (
            [.fiveHourLeft, .sevenDayLeft, .opusLeft, .sonnetLeft]
            | map(select(. != null)) | min
        ))
    ' "$STATE_FILE")
    pref_pace=$(jq -r --arg id "$preferred" '
        .accounts[] | select(.id==$id and .linked==true)
        | (.paceProjectedHours // 99)
    ' "$STATE_FILE")
    if [[ -z "$pref_util" || "$pref_util" == "null" ]]; then
        quit "prioritize: no data for preferred"
    fi
    pref_paceWarn=$(awk -v p="$pref_pace" 'BEGIN { print (p < 1) }')
    pref_overThreshold=$(awk -v u="$pref_util" -v t="$threshold" 'BEGIN { print (u > t) }')
    if [[ "$current_id" == "$preferred" ]]; then
        # We're on preferred — leave only if exceeded threshold or pace warn.
        if [[ "$pref_overThreshold" == "1" || "$pref_paceWarn" == "1" ]]; then
            target=$(jq -r --arg ex "$preferred" '
                [.accounts[] | select(.linked==true and .id != $ex)]
                | sort_by(.score) | reverse | .[0].id // empty
            ' "$STATE_FILE")
        else
            target="$preferred"   # stay on preferred
        fi
    else
        # Off preferred — return only after threshold-5pp recovery buffer.
        recovery=$(awk -v t="$threshold" 'BEGIN { print t - 5 }')
        pref_recovered=$(awk -v u="$pref_util" -v r="$recovery" 'BEGIN { print (u < r) }')
        if [[ "$pref_recovered" == "1" && "$pref_paceWarn" == "0" ]]; then
            target="$preferred"
        else
            target="$current_id"  # not yet — stay
        fi
    fi
    ;;
  balance)
    hysteresis=$(jq -r '.strategy.balance.hysteresis // 8' "$STATE_FILE")
    best_id=$(jq -r '
        [.accounts[] | select(.linked==true)]
        | sort_by(.score) | reverse | .[0].id // empty
    ' "$STATE_FILE")
    [[ -n "$best_id" ]] || quit "balance: no linked accounts"
    if [[ "$best_id" == "$current_id" ]]; then
        target="$current_id"
    else
        best_score=$(jq -r --arg id "$best_id" \
            '.accounts[] | select(.id==$id) | .score' "$STATE_FILE")
        cur_score=$(jq -r --arg id "$current_id" \
            '(.accounts[] | select(.id==$id) | .score) // 0' "$STATE_FILE")
        diff=$(awk -v b="$best_score" -v c="$cur_score" 'BEGIN { print b - c }')
        switch=$(awk -v d="$diff" -v h="$hysteresis" 'BEGIN { print (d > h) }')
        if [[ "$switch" == "1" ]]; then
            target="$best_id"
        else
            target="$current_id"
        fi
    fi
    ;;
  *)
    quit "unknown strategy: $strategy_kind"
    ;;
esac

[[ -n "$target" && "$target" != "$current_id" ]] || quit "no switch needed"

# ── apply switch by copying saved entry onto active slot ─────────────────
saved_svc="${SAVED_PREFIX}${target}"
token=$(security find-generic-password -s "$saved_svc" -a "$ACCT" -w 2>/dev/null) \
    || quit "saved entry missing for $target"

# Use update-or-add (-U); -T "" preserves the broad-access ACL the in-app
# integration uses. Silent on success.
security add-generic-password -U -s "$ACTIVE_SVC" -a "$ACCT" -T "" -w "$token" >/dev/null 2>&1 \
    || quit "keychain write failed"

log "switched active to $target"
exit 0
